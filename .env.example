# For local dev with `wrangler pages dev`, copy this file to `.dev.vars`
# (NOT .env — wrangler reads .dev.vars specifically) and fill in real values.
# In production, set these in the Cloudflare dashboard or via CLI:
#   npx wrangler pages secret put NAME --project-name=cohost-website

# ─── Email (Resend) ───
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
OWNER_EMAIL=you@gmail.com
# Optional. Defaults to "Cohost <onboarding@resend.dev>".
# Switch to "Cohost <hello@cohost.live>" after verifying a domain in Resend.
# SENDER_EMAIL=Cohost <hello@cohost.live>

# Optional. Absolute URL for assets in the email (logo image).
# Defaults to https://cohost-website.pages.dev
# WEBSITE_URL=https://cohost-website.pages.dev

# ─── Admin auth ───
# The password you'll use to sign in at /login.
ADMIN_PASSWORD=replace-with-a-strong-password

# A long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates all existing sessions.
ADMIN_SECRET=replace-with-64-char-hex-string
